{
  // To enforce the entire ground to be flat, set "min_travel_distance" to a small value (e.g., 20) and "max_neighbor_distance" to a huge value (e.g., 1e4)
  // more important set "level_factor_stddev" to a value ~ smaller than the smallest the noise in z (graph) of the gps (e.g. 1e-4) (so that in the optimization the flat factor wins)
  "flat_earther": {
    "enable_flat_earther": false,
    "min_travel_distance": 5.0,
    "max_neighbor_distance": 1e4,
    "num_nearest_neighbors": 10,
    "num_random_neighbors": 10,
    "level_factor_stddev": 1e-4,
    "robust_kernel_width": -1.0
  }
}